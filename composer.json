{
    "name": "verbb/abandoned-cart",
    "description": "A Craft CMS plugin for recovering abandoned Craft Commerce carts with email reminders.",
    "type": "craft-plugin",
    "version": "5.0.0-alpha.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "abandoned-cart"
    ],
    "support": {
        "email": "support@verbb.io",
        "issues": "https://github.com/verbb/abandoned-cart/issues?state=open",
        "source": "https://github.com/verbb/abandoned-cart",
        "docs": "https://github.com/verbb/abandoned-cart",
        "rss": "https://github.com/verbb/abandoned-cart/commits/v2.atom"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Verbb",
            "homepage": "https://verbb.io"
        },
        {
            "name": "Myles",
            "homepage": "https://github.com/mediabeastnz"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "craftcms/commerce": "^5.0.0",
        "verbb/base": "^3.0.20"
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin": "^3.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "verbb\\abandonedcart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "verbb\\abandonedcart\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test:integration": "ddev test"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Abandoned Cart",
        "handle": "abandoned-cart",
        "changelogUrl": "https://raw.githubusercontent.com/verbb/abandoned-cart/craft-5/CHANGELOG.md",
        "class": "verbb\\abandonedcart\\AbandonedCart"
    }
}
