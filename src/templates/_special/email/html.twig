{#
    The bundled Abandoned Cart email. Copy it with Copy Templates on an email template to change it.

    Variables: subject, previewText, heading, message, buttonLabel, discountCode, cart (items, total, currency, firstName),
    order (the Commerce order, when there is one), site, storeName, storeAddress, recoverUrl, unsubscribeUrl, isTest.
#}
{%- set ink = '#1f2933' -%}
{%- set muted = '#6b7280' -%}
{%- set line = '#e5e7eb' -%}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#ffffff;-webkit-text-size-adjust:100%;">
    {% if previewText %}
        <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ previewText }}&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>
    {% endif %}

    {# All white, so the email reads as a page rather than a card on a grey background. #}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;">
        <tr>
            <td align="center" style="padding:16px 8px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:{{ ink }};">
                    <tr>
                        <td style="padding:24px 24px 8px;">
                            <p style="margin:0 0 24px;font-size:13px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;">{{ storeName }}</p>

                            {% if heading %}
                                <h1 style="margin:0 0 14px;font-size:24px;line-height:1.25;font-weight:700;">{{ heading }}</h1>
                            {% endif %}

                            {% if message %}
                                <div style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#374151;">{{ message }}</div>
                            {% endif %}
                        </td>
                    </tr>

                    {% if cart.items %}
                        <tr>
                            <td style="padding:0 24px;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                                    {% for item in cart.items %}
                                        <tr>
                                            <td width="52" style="padding:12px 0;border-top:1px solid {{ line }};vertical-align:middle;">
                                                <div style="width:44px;height:44px;border-radius:8px;background:#efe9e1;color:#8a6d4f;font-size:16px;font-weight:700;line-height:44px;text-align:center;">{{ item.title | slice(0, 1) | upper }}</div>
                                            </td>
                                            <td style="padding:12px 12px;border-top:1px solid {{ line }};vertical-align:middle;font-size:14px;line-height:1.4;">
                                                <strong>{{ item.title }}</strong><br>
                                                <span style="color:{{ muted }};font-size:13px;">{{ item.description ? item.description ~ ' · ' }}{{ 'Qty {qty}' | t('abandoned-cart', { qty: item.qty }) }}</span>
                                            </td>
                                            <td align="right" style="padding:12px 0;border-top:1px solid {{ line }};vertical-align:middle;font-size:14px;font-weight:600;white-space:nowrap;">{{ cart.formatMoney(item.subtotal) }}</td>
                                        </tr>
                                    {% endfor %}
                                    <tr>
                                        <td colspan="2" style="padding:12px 0 4px;border-top:1px solid {{ line }};font-size:14px;">{{ 'Subtotal' | t('abandoned-cart') }}</td>
                                        <td align="right" style="padding:12px 0 4px;border-top:1px solid {{ line }};font-size:14px;font-weight:700;">{{ cart.formatMoney(cart.subtotal) }}</td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" style="padding:0 0 4px;font-size:13px;color:{{ muted }};">{{ 'Shipping and tax' | t('abandoned-cart') }}</td>
                                        <td align="right" style="padding:0 0 4px;font-size:13px;color:{{ muted }};">{{ 'At checkout' | t('abandoned-cart') }}</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    {% endif %}

                    {% if discountCode %}
                        <tr>
                            <td style="padding:20px 24px 0;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f7f4ef;border-radius:10px;">
                                    <tr>
                                        <td align="center" style="padding:16px;font-size:13px;color:#5d554e;">
                                            {{ 'This code is added to your cart when you return' | t('abandoned-cart') }}<br>
                                            <span style="display:inline-block;margin-top:8px;padding:6px 14px;border:1px dashed #b7a58f;border-radius:6px;font-family:ui-monospace,Menlo,monospace;font-size:16px;font-weight:700;color:{{ ink }};letter-spacing:.06em;">{{ discountCode }}</span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    {% endif %}

                    <tr>
                        <td style="padding:24px 24px 28px;">
                            <a href="{{ recoverUrl }}" style="display:inline-block;background:{{ ink }};color:#ffffff;text-decoration:none;font-size:15px;font-weight:600;padding:13px 22px;border-radius:8px;">{{ buttonLabel }}</a>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:20px 24px 24px;border-top:1px solid {{ line }};font-size:12px;line-height:1.6;color:{{ muted }};">
                            {% if storeAddress %}{{ storeName }} · {{ storeAddress }}<br>{% endif %}
                            {{ 'You’re getting this because you left items in your cart at {siteName}.' | t('abandoned-cart', { siteName: site.name ?? storeName }) }}
                            <a href="{{ unsubscribeUrl }}" style="color:{{ muted }};">{{ 'Unsubscribe from cart reminders' | t('abandoned-cart') }}</a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
